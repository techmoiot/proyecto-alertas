# Copiar a /etc/mk-monitor/mk-monitor.env (install.sh lo hace solo).
# Después de cambiar algo: sudo systemctl restart mk-monitor

MKMON_HOST=0.0.0.0
MKMON_PORT=8080
MKMON_DB=/var/lib/mk-monitor/mkmonitor.db

# Acceso al panel (usuario y contraseña con HTTP Basic)
MKMON_ADMIN_USER=admin
MKMON_ADMIN_PASSWORD=cambiame

# Token que usa el script de los MikroTik para registrarse en el servidor
MKMON_REGISTER_TOKEN=cambiame-tambien

# 1 = el panel se puede VER sin contraseña (útil para una pantalla/TV).
# Reconocer alertas y configurar sigue pidiendo contraseña.
MKMON_PUBLIC_VIEW=0

# Avisos por Telegram (opcional)
#MKMON_TELEGRAM_TOKEN=123456:ABC...
#MKMON_TELEGRAM_CHAT=-1001234567890

# Puerto UDP donde llega el log (syslog) de PPPoE de los MikroTik. 0 = apagado.
# Si hay firewall, abrir este puerto UDP hacia el servidor.
MKMON_SYSLOG_PORT=5140

# Conexión remota de MikroTik (túnel WireGuard). El servidor usa la primera IP de esta red.
#MKMON_WG_NETWORK=10.77.0.0/24
#MKMON_WG_PORT=51820
# IP pública o dominio con el que los routers llegan al servidor (también se carga desde el panel)
#MKMON_WG_ENDPOINT=
